# Public base URL of the site, without a trailing slash.
BASE_URL="http://localhost:3000"

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"

# Random secret (32+ chars) used to sign the session cookie. Generate your own, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-random-string-at-least-32-characters-long"

# Authentik OIDC provider settings (issuer = provider's "OpenID Configuration Issuer")
AUTHENTIK_ISSUER="https://authentik.example.com/application/o/your-app-slug/"
AUTHENTIK_CLIENT_ID="replace-with-client-id"
AUTHENTIK_CLIENT_SECRET="replace-with-client-secret"
AUTHENTIK_SCOPES="openid profile email"
